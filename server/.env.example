NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/online_voting_system
JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_EXPIRES_IN=8h
RECEIPT_SECRET=change-this-receipt-hmac-secret
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
MAX_SELFIE_BYTES=5242880

# SMTP (Gmail example — use App Password, NOT your regular Gmail password)
#
# Setup steps:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to Google Account → Security → App passwords
#   3. Create an app password for "Mail" / "Other (Online Voting)"
#   4. Paste the 16-character password below as SMTP_PASS
#   5. Set SMTP_USER to your Gmail address and SMTP_FROM to a display name
#
# Without SMTP configured, dev mode logs [DEV EMAIL] to the server console
# (OTP codes and reset codes appear in terminal — sufficient for local demo).
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Victoria University Election Services <your-email@gmail.com>"

# Face verification threshold (0-1, higher = stricter)
FACE_MATCH_THRESHOLD=0.65
FACE_ANOMALY_THRESHOLD=0.45

# Default admin (created on seed)
ADMIN_STUDENT_ID=S8139428
ADMIN_EMAIL=s8139428@live.vu.edu.au
ADMIN_PASSWORD=Admin@12345

# Test data generator (dev/demo). Disabled in production unless explicitly enabled.
ALLOW_TEST_GENERATOR=true

# Login OTP (MFA) is always required after a correct password.
# Set REQUIRE_LOGIN_OTP=false only for emergency local bypass (not recommended).
REQUIRE_LOGIN_OTP=true

# Notes (security residuals accepted for classroom demo):
# - Seed ADMIN_PASSWORD above is demo-only; rotate before any real deploy.
# - Swagger UI (/api/docs) is auto-disabled when NODE_ENV=production.
# - New elections default showLiveResultsPublic=false; seed/demo sets true for public live view.
# - Auth JWT is set as httpOnly cookie; login responses also return token for SPA Authorization header.
